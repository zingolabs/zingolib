# Rust is intentionally not set here. The canonical source is
# rust-toolchain.toml's `channel`; Makefile.toml derives RUST_VERSION from it.

# Zaino image tag used to provide zainod (https://hub.docker.com/r/zingodevops/zaino)
ZAINO_IMAGE_TAG=0.8.0-no-tls
# Manifest digest the tag resolved to when pinned (2026-08-19). Tags are
# mutable pointers; the digest is content. docker-ci consumes
# tag@digest, so an upstream repush of the tag fails the build loudly
# instead of silently changing which zainod the tests run.
ZAINO_IMAGE_DIGEST=sha256:8aa3104dbfca18077c9b8e9dbfac54e6dabc4e4679afb7cf919066d8f0a599b9

# Zebra Git tag without the leading "v" (https://github.com/ZcashFoundation/zebra/releases)
ZEBRA_VERSION=6.3.0
# Same tag-vs-content discipline as the zaino digest above (2026-08-19).
ZEBRA_IMAGE_DIGEST=sha256:52a67e543906c98a0ed1599e2ce3ee238fc05b40592ae26ee5914ddb6ede51e3

# cargo-nextest version compatible with the pinned Rust toolchain.
NEXTEST_VERSION=0.9.128
